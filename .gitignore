.DS_Store
tmux-client-*.log
.claude/

# Stow package: track only portable user prefs, ignore runtime state
# (cache/, projects/, sessions/, telemetry/, history.jsonl, plans/, etc.)
!claude/.claude/
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json
# skills/ holds only symlinks into agents/.agents/skills (the tracked store)
!claude/.claude/skills

# Project-local Claude Code skills (track skills/, ignore everything else
# under .claude/ — settings.local.json, projects/, cache/, etc.)
!/.claude/
/.claude/*
!/.claude/skills/

# herdr writes runtime state next to its config (session.json, session-history
# .json, logs, sockets). Track config.toml only — belt and braces alongside
# bootstrap.sh pre-creating ~/.config/herdr so stow can't fold it.
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml

scripts/Brewfile.lock.json
